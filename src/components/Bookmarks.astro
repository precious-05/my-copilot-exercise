<section class="bookmark-manager" aria-labelledby="manager-title">
  <div class="manager-heading">
    <div>
      <p class="eyebrow">Personal library</p>
      <h2 id="manager-title">Save a link</h2>
    </div>
  </div>

  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="off"
        spellcheck="false"
        placeholder="https://example.com"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>

  <p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>
  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" hidden>
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import { STORAGE_KEY, normalizeUrl, parseStoredBookmarks, toBase62 } from '../lib/bookmarks.js';

  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');

  let bookmarks = loadBookmarks();

  function loadBookmarks() {
    try {
      return parseStoredBookmarks(window.localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function saveBookmarks() {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch {
      // Keep the in-memory list usable if storage is unavailable or full.
    }
  }

  function generateSlug() {
    const seed = (Date.now() + Math.floor(Math.random() * 100000)) % Number.MAX_SAFE_INTEGER;
    return `mona-${toBase62(seed)}`;
  }

  function render() {
    if (!(list instanceof HTMLUListElement)) return;
    list.replaceChildren();

    for (const bookmark of bookmarks) {
      const row = document.createElement('li');
      row.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.textContent = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';

      const separator = document.createTextNode(' :: ');

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          copy.textContent = 'Copied';
          window.setTimeout(() => { copy.textContent = 'Copy'; }, 1200);
        } catch {
          copy.textContent = 'Copy';
        }
      });

      row.append(link, separator, slug, copy);
      list.append(row);
    }

    const hasBookmarks = bookmarks.length > 0;
    if (emptyState instanceof HTMLElement) emptyState.hidden = hasBookmarks;
    if (listHeader instanceof HTMLElement) listHeader.hidden = !hasBookmarks;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!(input instanceof HTMLInputElement)) return;
    const url = normalizeUrl(input.value);
    if (!url) {
      input.setCustomValidity('Enter a valid web URL');
      input.reportValidity();
      return;
    }

    input.setCustomValidity('');
    let slug = generateSlug();
    while (bookmarks.some((bookmark) => bookmark.slug === slug)) {
      slug = generateSlug();
    }

    bookmarks = [...bookmarks, { url, slug }];
    saveBookmarks();
    render();
    input.value = '';
    input.focus();
  });

  input?.addEventListener('input', () => {
    if (input instanceof HTMLInputElement) input.setCustomValidity('');
  });

  clearAll?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    try {
      window.localStorage.removeItem(STORAGE_KEY);
    } catch {
      // The view still clears even if browser storage is unavailable.
    }
    render();
  });

  render();
</script>
